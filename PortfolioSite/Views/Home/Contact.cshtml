@model PortfolioSite.ViewModels.ContactViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "İletişim";
}
<section class="section" style="padding-top:6rem;">
    <div class="container" style="max-width:600px;">
        <div class="section-header fade-in">
            <span class="badge badge-blue">İletişim</span>
            <h1>Mesaj <span class="gradient-text">Gönder</span></h1>
        </div>
        @if (TempData["Success"] != null) {
            <div class="alert alert-success alert-auto-dismiss">@TempData["Success"]</div>
        }
        <div class="card fade-in">
            <form asp-action="Contact" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div style="display:none" aria-hidden="true"><input type="text" name="Website" tabindex="-1" /></div>
                <div class="form-group"><label class="form-label">Ad Soyad *</label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
                <div class="form-group"><label class="form-label">E-posta *</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="form-group"><label class="form-label">Konu</label><input asp-for="Subject" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Mesaj *</label><textarea asp-for="Message" class="form-control" rows="6"></textarea><span asp-validation-for="Message" class="text-danger"></span></div>
                <div class="form-group"><div class="form-check"><input asp-for="ConsentGiven" class="form-check-input" /><label asp-for="ConsentGiven" class="form-check-label">Kişisel verilerimin işlenmesini kabul ediyorum.</label></div></div>
                <button type="submit" class="btn btn-primary">Mesaj Gönder</button>
            </form>
        </div>
    </div>
</section>
