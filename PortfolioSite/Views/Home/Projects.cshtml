@model List<PortfolioSite.Entities.Project>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Projeler";
}
<section class="section" style="padding-top:6rem;">
    <div class="container">
        <div class="section-header fade-in">
            <span class="badge badge-purple">Projeler</span>
            <h1>Tüm <span class="gradient-text">Projelerim</span></h1>
            <div class="section-divider"></div>
        </div>
        @if (Model.Any()) {
            <div class="projects-grid">
                @foreach (var project in Model) {
                    <article class="project-card fade-in">
                        <div class="project-image">
                            @if (!string.IsNullOrEmpty(project.CoverImagePath)) {
                                <img src="@project.CoverImagePath" alt="@project.Name" loading="lazy" />
                            } else {
                                <div class="project-placeholder">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                                </div>
                            }
                        </div>
                        <div class="project-body">
                            <h2 class="project-title">@project.Name</h2>
                            @if (!string.IsNullOrEmpty(project.Summary)) {
                                <p class="project-summary">@project.Summary</p>
                            }
                            @if (!string.IsNullOrEmpty(project.Technologies)) {
                                <div class="project-tech">
                                    @foreach (var tech in project.Technologies.Split(',').Take(5)) {
                                        <span class="tech-tag">@tech.Trim()</span>
                                    }
                                </div>
                            }
                            <div class="project-links">
                                <a href="/projeler/@project.Slug" class="btn btn-sm btn-ghost">Detaylar</a>
                                @if (!string.IsNullOrEmpty(project.GitHubUrl)) {
                                    <a href="@project.GitHubUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline">GitHub</a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        } else {
            <div class="empty-state">
                <p>Henüz proje eklenmemiş.</p>
            </div>
        }
    </div>
</section>
