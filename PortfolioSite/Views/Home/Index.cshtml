@model PortfolioSite.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    var profile = Model.Profile;
}

<!-- HERO SECTION -->
<section id="hero" class="hero-section" aria-label="Giriş ve Özet">
    <div class="container">
        <div class="hero-layout">
            <div class="hero-content">
                @if (!string.IsNullOrWhiteSpace(profile?.HeroBadgeText)) {
                    <div class="hero-badge">
                        <span class="status-dot"></span>
                        <span>@profile.HeroBadgeText</span>
                    </div>
                }
                
                <h1 class="hero-title notranslate" translate="no">
                    @(profile?.FullName ?? "John Doe")
                </h1>

                <div class="hero-subtitle">
                    @(profile?.Title ?? "Software Engineer & Backend Developer")
                </div>

                <p class="hero-description">
                    @(profile?.ShortBio ?? "Kurumsal iş süreçleri, SQL Server ve ASP.NET Core tabanlı sürdürülebilir yüksek performanslı uygulamalar geliştiriyorum.")
                </p>

                <div class="hero-actions">
                    <a href="/#projects" class="btn-primary">
                        Projelerimi Gör →
                    </a>
                    <a href="/#contact" class="btn-secondary">
                        İletişim
                    </a>
                    @if (!string.IsNullOrEmpty(profile?.CvFilePath)) {
                        <a href="/Home/DownloadCv" class="btn-secondary mono">
                            CV İndir ↓
                        </a>
                    }
                </div>
            </div>

            <!-- Balanced Profile Photo Frame -->
            <div class="hero-photo-box">
                <div class="photo-wrapper">
                    @if (!string.IsNullOrEmpty(profile?.ProfileImagePath)) {
                        <img src="@profile.ProfileImagePath" alt="@(profile?.FullName ?? "Profil") fotoğrafı" />
                    } else {
                        var initials = string.Concat((profile?.FullName ?? "JD").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));
                        <div class="avatar-placeholder notranslate" translate="no">
                            @initials
                        </div>
                    }
                </div>

                <div class="photo-info-card">
                    <div class="photo-info-item">
                        <span>Konum:</span>
                        <span>@(profile?.Location ?? "Türkiye")</span>
                    </div>
                    <div class="photo-info-item">
                        <span>Uzmanlık:</span>
                        <span>@(profile?.Specialization ?? "SQL Server / C#")</span>
                    </div>

                    <div class="photo-social-links">
                        @if (!string.IsNullOrEmpty(profile?.GitHubUrl)) {
                            <a href="@profile.GitHubUrl" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="GitHub">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                                <span>GitHub</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(profile?.LinkedInUrl)) {
                            <a href="@profile.LinkedInUrl" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="LinkedIn">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                                <span>LinkedIn</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ABOUT SECTION -->
<section id="about" class="section" aria-label="Hakkımda">
    <div class="container">
        <div class="about-grid">
            <div class="about-text">
                <span class="section-tag">Hakkımda</span>
                <h2 class="section-title">Kim Olduğumu Keşfedin</h2>
                @if (!string.IsNullOrEmpty(profile?.AboutText)) {
                    @Html.Raw(profile.AboutText.Replace("\n", "<br/>"))
                } else {
                    <p>
                        Yazılım geliştirme alanında backend ve veritabanı üzerine uzmanlaşmış bir geliştiriciyim. C#, ASP.NET Core MVC, Entity Framework Core ve Microsoft SQL Server teknolojilerini kullanarak kurumsal düzeyde, ölçeklenebilir ve sürdürülebilir uygulamalar geliştiriyorum.
                    </p>
                    <p>
                        Kurumsal ERP entegrasyonları, iş akışı ve onay süreçleri, muhasebe ve finans sistemleri üzerine deneyim sahibiyim. Stored Procedure, Trigger, View, CTE ve JSON işlemleri konularında ileri düzey SQL Server bilgisine sahibim.
                    </p>
                }
            </div>

            <div class="info-list-card">
                <h4>Detaylar & Uzmanlık</h4>
                <div class="info-row">
                    <div class="info-row-label">Odak Alanı</div>
                    <div class="info-row-val">Backend & Veritabanı Mimarisi</div>
                </div>
                <div class="info-row">
                    <div class="info-row-label">Teknolojiler</div>
                    <div class="info-row-val">C#, ASP.NET Core, EF Core, SQL Server</div>
                </div>
                <div class="info-row">
                    <div class="info-row-label">Veritabanı Yetkinliği</div>
                    <div class="info-row-val">T-SQL, Stored Procedure, Trigger, CTE, JSON</div>
                </div>
                <div class="info-row">
                    <div class="info-row-label">Süreçler</div>
                    <div class="info-row-val">ERP Entegrasyonu, İş Akışları, Muhasebe</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SKILLS SECTION -->
<section id="skills" class="section" aria-label="Yetenekler">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Uzmanlıklar</span>
            <h2 class="section-title">Teknik Yetenekler</h2>
            <p class="section-subtitle">Geliştirme süreçlerinde aktif olarak kullandığım dil, çerçeve ve veritabanı teknolojileri.</p>
        </div>

        <div class="skills-grid">
            @foreach (var cat in Model.SkillCategories) {
                <div class="skill-category-box">
                    <div class="skill-category-title">
                        <span>#</span>
                        <span>@cat.Name</span>
                    </div>
                    <div class="skill-list">
                        @foreach (var skill in cat.Skills) {
                            <span class="skill-chip">@skill.Name</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- EXPERIENCE SECTION -->
<section id="experience" class="section" aria-label="Deneyim">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Kariyer Yolculuğu</span>
            <h2 class="section-title">İş Deneyimi</h2>
            <p class="section-subtitle">Kurumsal projelerde ve yazılım ekiplerinde üstlendiğim sorumluluklar.</p>
        </div>

        <div class="experience-list">
            @if (Model.Experiences.Any()) {
                @foreach (var exp in Model.Experiences) {
                    <div class="exp-card">
                        <div class="exp-header">
                            <div>
                                <h3 class="exp-title">@exp.Position</h3>
                                @if (!exp.HideCompanyName && !string.IsNullOrEmpty(exp.Company)) {
                                    <div class="exp-company">@exp.Company</div>
                                }
                            </div>
                            <div class="exp-date">
                                @exp.StartDate.ToString("MMM yyyy") - @(exp.IsCurrentJob ? "Halen" : exp.EndDate?.ToString("MMM yyyy"))
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(exp.Description)) {
                            <p class="exp-desc">@exp.Description</p>
                        }

                        @if (!string.IsNullOrEmpty(exp.Technologies)) {
                            <div class="exp-techs">
                                <strong>Yığın:</strong> @exp.Technologies
                            </div>
                        }
                    </div>
                }
            } else {
                <p class="mono" style="color:var(--text-dim);">Henüz bir deneyim bilgisi eklenmedi.</p>
            }
        </div>
    </div>
</section>

<!-- PROJECTS SECTION -->
<section id="projects" class="section" aria-label="Projeler">
    <div class="container">
        <div class="section-header">
            <span class="section-tag">Portföy</span>
            <h2 class="section-title">Öne Çıkan Projeler</h2>
            <p class="section-subtitle">Geliştirdiğim kurumsal modüller, entegrasyonlar ve web uygulamaları.</p>
        </div>

        <div class="projects-grid">
            @if (Model.FeaturedProjects.Any()) {
                @foreach (var project in Model.FeaturedProjects) {
                    <div class="project-card">
                        <div class="project-cover-container">
                            @if (!string.IsNullOrEmpty(project.CoverImagePath)) {
                                <img src="@project.CoverImagePath" alt="@project.Name görseli" />
                            } else {
                                <div class="project-cover-placeholder">
                                    <span>&lt;/&gt;</span>
                                </div>
                            }
                        </div>
                        <div class="project-body">
                            <h3 class="project-title">@project.Name</h3>
                            <p class="project-summary">@project.Summary</p>

                            @if (!string.IsNullOrEmpty(project.Technologies)) {
                                <div class="project-tech-tags">
                                    <span>@project.Technologies</span>
                                </div>
                            }

                            <div class="project-actions">
                                <a href="/Home/Project?slug=@project.Slug" class="btn-primary" style="font-size:0.8rem;padding:0.5rem 1rem;">
                                    Detay Gör →
                                </a>
                                @if (!string.IsNullOrEmpty(project.LiveUrl)) {
                                    <a href="@project.LiveUrl" target="_blank" class="btn-secondary" style="font-size:0.8rem;padding:0.5rem 0.8rem;">
                                        Canlı Demo ↗
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            } else {
                <p class="mono" style="color:var(--text-dim);">Henüz öne çıkan proje eklenmedi.</p>
            }
        </div>
    </div>
</section>

<!-- CERTIFICATES SECTION -->
@if (Model.Certificates.Any()) {
    <section id="certificates" class="section" aria-label="Sertifikalar">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Başarılar</span>
                <h2 class="section-title">Sertifikalar</h2>
            </div>

            <div class="certificates-grid">
                @foreach (var cert in Model.Certificates) {
                    <div class="cert-card">
                        <div class="cert-cover-container">
                            @if (!string.IsNullOrEmpty(cert.ImagePath)) {
                                <img src="@cert.ImagePath" alt="@cert.Name sertifikası" />
                            } else {
                                <div class="cert-cover-placeholder">
                                </div>
                            }
                        </div>
                        <div class="cert-body">
                            <div>
                                <h3 class="cert-title">@cert.Name</h3>
                                @if (!string.IsNullOrEmpty(cert.IssuingOrganization)) {
                                    <div class="cert-org">@cert.IssuingOrganization</div>
                                }
                            </div>
                            <div class="cert-footer">
                                <span class="cert-date">@cert.IssuedDate.ToString("yyyy") - @(cert.ExpiryDate.HasValue ? cert.ExpiryDate.Value.ToString("yyyy") : "∞")</span>
                                @if (!string.IsNullOrEmpty(cert.VerificationUrl)) {
                                    <a href="@cert.VerificationUrl" target="_blank" class="cert-link">Doğrula ↗</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- CONTACT SECTION -->
<section id="contact" class="section" aria-label="İletişim">
    <div class="container">
        <div class="contact-layout">
            <div class="contact-info-side">
                <span class="section-tag">İletişim</span>
                <h2 class="section-title">Birlikte Çalışalım</h2>
                <p class="section-subtitle">
                    Kurumsal projeniz, veritabanı optimizasyonu veya iş fırsatları için mesaj gönderebilirsiniz.
                </p>

                @if (!string.IsNullOrEmpty(profile?.Email)) {
                    <div class="contact-email-box">
                        <a href="mailto:@profile.Email">@profile.Email</a>
                    </div>
                }
            </div>

            <div class="contact-form-card">
                <form asp-controller="Home" asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div style="display:none" aria-hidden="true"><input type="text" name="Website" tabindex="-1" /></div>
                    
                    <div class="form-group">
                        <label class="form-label" for="contact-fullname">Ad Soyad *</label>
                        <input type="text" id="contact-fullname" name="FullName" class="form-control" placeholder="Adınız Soyadınız" required />
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="contact-email">E-posta *</label>
                        <input type="email" id="contact-email" name="Email" class="form-control" placeholder="ornek@domain.com" required />
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="contact-subject">Konu</label>
                        <input type="text" id="contact-subject" name="Subject" class="form-control" placeholder="Proje / Danışmanlık / İletişim" />
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="contact-message">Mesajınız *</label>
                        <textarea id="contact-message" name="Message" class="form-control" rows="4" placeholder="Mesajınızı buraya yazabilirsiniz..." required></textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-check">
                            <input type="checkbox" name="ConsentGiven" value="true" checked required />
                            <span>Kişisel verilerimin işlenmesini kabul ediyorum.</span>
                        </label>
                    </div>
                    
                    <button type="submit" class="btn-primary" style="width:100%;justify-content:center;">
                        Mesaj Gönder →
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
