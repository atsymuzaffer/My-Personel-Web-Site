@model PortfolioSite.Entities.Project
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Name;
}
<section class="section" style="padding-top:6rem;">
    <div class="container" style="max-width:900px;">
        <a href="/#projects" class="btn btn-ghost btn-sm" style="margin-bottom:1.5rem;display:inline-flex;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Projelere Dön
        </a>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;align-items:center;margin-bottom:1rem;">
            @if (Model.IsFeatured) { <span class="badge badge-purple">★ Öne Çıkan</span> }
            <span class="badge badge-blue">@Model.Status</span>
        </div>
        <h1 style="font-size:clamp(1.75rem,4vw,2.5rem);font-weight:900;margin-bottom:1rem;">@Model.Name</h1>
        @if (!string.IsNullOrEmpty(Model.Summary)) {
            <p style="font-size:1.05rem;margin-bottom:2rem;">@Model.Summary</p>
        }
        @if (!string.IsNullOrEmpty(Model.CoverImagePath)) {
            <img src="@Model.CoverImagePath" alt="@Model.Name" style="width:100%;border-radius:var(--radius);border:1px solid var(--border-subtle);margin-bottom:2rem;" />
        }
        <div class="card" style="margin-bottom:1.5rem;">
            @if (!string.IsNullOrEmpty(Model.Description)) {
                <h2 style="font-size:1.1rem;margin-bottom:0.75rem;">Proje Hakkında</h2>
                <p>@Model.Description</p>
            }
        </div>
        @if (!string.IsNullOrEmpty(Model.ProblemStatement)) {
            <div class="card" style="margin-bottom:1.5rem;">
                <h2 style="font-size:1.1rem;margin-bottom:0.75rem;">Problem</h2>
                <p>@Model.ProblemStatement</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Solution)) {
            <div class="card" style="margin-bottom:1.5rem;">
                <h2 style="font-size:1.1rem;margin-bottom:0.75rem;">Çözüm</h2>
                <p>@Model.Solution</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Technologies)) {
            <div class="card" style="margin-bottom:1.5rem;">
                <h2 style="font-size:1.1rem;margin-bottom:0.75rem;">Kullanılan Teknolojiler</h2>
                <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                    @foreach (var tech in Model.Technologies.Split(',', StringSplitOptions.RemoveEmptyEntries)) {
                        <span class="tech-tag">@tech.Trim()</span>
                    }
                </div>
            </div>
        }
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
            @if (!string.IsNullOrEmpty(Model.GitHubUrl)) {
                <a href="@Model.GitHubUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline">GitHub'da Gör</a>
            }
            @if (!string.IsNullOrEmpty(Model.LiveUrl)) {
                <a href="@Model.LiveUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Canlı Demo</a>
            }
        </div>
    </div>
</section>
