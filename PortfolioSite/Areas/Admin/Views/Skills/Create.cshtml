@model PortfolioSite.Entities.Skill
@{
    ViewData["Title"] = "Yetenek Ekle";
}
<div class="page-header">
    <div><h1 class="page-title">Yetenek Ekle</h1></div>
    <a href="/Admin/Skills" class="btn-admin btn-admin-secondary">← Geri</a>
</div>
<div class="admin-card">
    <div class="admin-card-body">
        <form asp-area="Admin" asp-controller="Skills" asp-action="Create" method="post" class="admin-form">
            @Html.AntiForgeryToken()
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">Yetenek Adı *</label><input asp-for="Name" class="form-control" required /></div>
                <div class="form-group"><label class="form-label">Kategori *</label><select asp-for="SkillCategoryId" class="form-control">@foreach (var cat in (List<PortfolioSite.Entities.SkillCategory>)ViewBag.Categories) {<option value="@cat.Id">@cat.Name</option>}</select></div>
            </div>
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">Seviye</label><select asp-for="Level" class="form-control"><option value="1">Başlangıç</option><option value="2" selected>Orta</option><option value="3">İleri</option><option value="4">Uzman</option></select></div>
                <div class="form-group"><label class="form-label">Sıralama</label><input asp-for="SortOrder" class="form-control" type="number" value="0" /></div>
            </div>
            <div class="form-group"><label class="form-label">Açıklama</label><input asp-for="Description" class="form-control" /></div>
            <div style="display:flex;gap:1rem;align-items:center;margin-bottom:1rem;">
                <div class="form-check" style="margin:0;"><input asp-for="IsFeatured" class="form-check-input" id="featured" /><label for="featured" class="form-check-label" style="font-size:0.875rem;color:var(--admin-text-secondary);">Ana sayfada öne çıkar</label></div>
                <div class="form-check" style="margin:0;"><input asp-for="IsActive" class="form-check-input" id="active" checked /><label for="active" class="form-check-label" style="font-size:0.875rem;color:var(--admin-text-secondary);">Aktif</label></div>
            </div>
            <div style="display:flex;gap:1rem;">
                <button type="submit" class="btn-admin btn-admin-primary">💾 Kaydet</button>
                <a href="/Admin/Skills" class="btn-admin btn-admin-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
