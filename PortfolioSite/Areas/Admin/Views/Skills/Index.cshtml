@model List<PortfolioSite.Entities.Skill>
@{
    ViewData["Title"] = "Yetenekler";
}
<div class="page-header">
    <div><h1 class="page-title">Yetenekler</h1><p class="page-subtitle">@Model.Count yetenek</p></div>
    <a href="/Admin/Skills/Create" class="btn-admin btn-admin-primary">+ Yetenek Ekle</a>
</div>
<div class="admin-card">
    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead><tr><th>Yetenek</th><th>Kategori</th><th>Seviye</th><th>Öne Çıkan</th><th>Aktif</th><th>İşlem</th></tr></thead>
            <tbody>
                @if (!Model.Any()) { <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--admin-text-muted);">Yetenek yok</td></tr> }
                @foreach (var s in Model) {
                    <tr>
                        <td style="font-weight:600;">@s.Name</td>
                        <td>@(s.Category?.Name ?? "—")</td>
                        <td>@s.Level</td>
                        <td>@(s.IsFeatured ? "⭐" : "—")</td>
                        <td><span class="badge-admin @(s.IsActive ? "badge-active" : "badge-inactive")">@(s.IsActive ? "Aktif" : "Pasif")</span></td>
                        <td style="display:flex;gap:0.5rem;">
                            <a href="/Admin/Skills/Edit/@s.Id" class="btn-admin btn-admin-secondary btn-admin-sm">Düzenle</a>
                            <form asp-area="Admin" asp-controller="Skills" asp-action="Delete" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="btn-admin btn-admin-danger btn-admin-sm" data-confirm-delete="@s.Name yeteneğini silmek istediğinizden emin misiniz?">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
