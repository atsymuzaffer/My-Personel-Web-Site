@{
    ViewData["Title"] = "Dashboard";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Portföy sitenize genel bakış</p>
    </div>
    <a href="/" target="_blank" class="btn-admin btn-admin-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
        Siteyi Gör
    </a>
</div>

<div class="stats-grid">
    <div class="stat-card-admin">
        <div class="stat-card-icon stat-icon-blue">📁</div>
        <div class="stat-card-info"><div class="value">@ViewBag.ActiveProjects</div><div class="label">Aktif Proje</div></div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-card-icon stat-icon-purple">📝</div>
        <div class="stat-card-info"><div class="value">@ViewBag.TotalBlogPosts</div><div class="label">Blog Yazısı</div></div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-card-icon stat-icon-red">📬</div>
        <div class="stat-card-info"><div class="value">@ViewBag.UnreadMessages</div><div class="label">Okunmamış Mesaj</div></div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-card-icon stat-icon-yellow">🎓</div>
        <div class="stat-card-info"><div class="value">@ViewBag.TotalCertificates</div><div class="label">Sertifika</div></div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-card-icon stat-icon-green">🛠</div>
        <div class="stat-card-info"><div class="value">@ViewBag.TotalSkills</div><div class="label">Yetenek</div></div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-card-icon stat-icon-cyan">📈</div>
        <div class="stat-card-info"><div class="value">@ViewBag.TotalProjects</div><div class="label">Toplam Proje</div></div>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h2 class="admin-card-title">📬 Son Mesajlar</h2>
        <a href="/Admin/Messages" class="btn-admin btn-admin-secondary btn-admin-sm">Tümünü Gör</a>
    </div>
    @if (ViewBag.RecentMessages != null) {
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead><tr><th>Gönderen</th><th>Konu</th><th>Tarih</th><th>Durum</th></tr></thead>
                <tbody>
                    @foreach (var msg in ViewBag.RecentMessages) {
                        <tr>
                            <td>@msg.FullName</td>
                            <td>@(msg.Subject ?? "(Konusuz)")</td>
                            <td>@msg.SentAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@if (!msg.IsRead) { <span class="badge-admin badge-unread">Yeni</span> } else { <span class="badge-admin badge-inactive">Okundu</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    } else {
        <div class="admin-card-body"><p style="color:var(--admin-text-muted);">Henüz mesaj yok.</p></div>
    }
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-top:1.5rem;">
    <a href="/Admin/Profile" class="admin-card" style="text-decoration:none;padding:1.25rem;display:flex;align-items:center;gap:0.75rem;transition:all 0.2s;">
        <span style="font-size:1.5rem;">👤</span>
        <div><div style="font-weight:700;font-size:0.875rem;">Profil Güncelle</div><div style="font-size:0.75rem;color:var(--admin-text-muted);">Kişisel bilgileri düzenle</div></div>
    </a>
    <a href="/Admin/Projects/Create" class="admin-card" style="text-decoration:none;padding:1.25rem;display:flex;align-items:center;gap:0.75rem;transition:all 0.2s;">
        <span style="font-size:1.5rem;">➕</span>
        <div><div style="font-weight:700;font-size:0.875rem;">Yeni Proje</div><div style="font-size:0.75rem;color:var(--admin-text-muted);">Proje ekle</div></div>
    </a>
    <a href="/Admin/Skills/Create" class="admin-card" style="text-decoration:none;padding:1.25rem;display:flex;align-items:center;gap:0.75rem;transition:all 0.2s;">
        <span style="font-size:1.5rem;">🛠</span>
        <div><div style="font-weight:700;font-size:0.875rem;">Yetenek Ekle</div><div style="font-size:0.75rem;color:var(--admin-text-muted);">Beceri ekle</div></div>
    </a>
    <a href="/Admin/Messages" class="admin-card" style="text-decoration:none;padding:1.25rem;display:flex;align-items:center;gap:0.75rem;transition:all 0.2s;">
        <span style="font-size:1.5rem;">📬</span>
        <div><div style="font-weight:700;font-size:0.875rem;">Mesajlar</div><div style="font-size:0.75rem;color:var(--admin-text-muted);">Gelen kutusunu gör</div></div>
    </a>
</div>
