@model PortfolioSite.Entities.Certificate
@{
    ViewData["Title"] = "Sertifika Düzenle";
}
<div class="page-header">
    <h1 class="page-title">Sertifika Düzenle</h1>
    <a href="/Admin/Certificates" class="btn-admin btn-admin-secondary">← Geri</a>
</div>
<div class="admin-card">
    <div class="admin-card-body">
        <form asp-area="Admin" asp-controller="Certificates" asp-action="Edit" method="post" enctype="multipart/form-data" class="admin-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group">
                <label class="form-label">Sertifika Adı *</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label">Sertifika Görseli</label>
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div style="margin-bottom: 0.5rem;">
                        <img src="@Model.ImagePath" alt="Mevcut Görsel" style="max-height: 100px; border-radius: 4px; border: 1px solid var(--admin-border);" />
                    </div>
                }
                <input type="file" name="image" class="form-control" accept="image/*" />
                <small style="color:var(--admin-text-muted);">Yeni bir görsel seçmezseniz mevcut görsel korunur.</small>
            </div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label">Kurum</label>
                    <input asp-for="IssuingOrganization" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Alınma Tarihi *</label>
                    <input asp-for="IssuedDate" class="form-control" type="date" required />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Sona Erme Tarihi</label>
                <input asp-for="ExpiryDate" class="form-control" type="date" />
                <small style="color:var(--admin-text-muted);">Süresiz ise boş bırakın.</small>
            </div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label">Credential ID</label>
                    <input asp-for="CredentialId" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Doğrulama URL</label>
                    <input asp-for="VerificationUrl" class="form-control" />
                </div>
            </div>

            <div class="form-group" style="display:flex; align-items:center; gap: 0.5rem; margin-top: 1rem;">
                <input asp-for="IsActive" type="checkbox" style="width:1.2rem; height:1.2rem;" />
                <label class="form-label" style="margin-bottom:0;">Aktif (Sitede Gösterilsin mi?)</label>
            </div>

            <div style="display:flex; gap:1rem; margin-top: 2rem;">
                <button type="submit" class="btn-admin btn-admin-primary">💾 Güncelle</button>
                <a href="/Admin/Certificates" class="btn-admin btn-admin-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
