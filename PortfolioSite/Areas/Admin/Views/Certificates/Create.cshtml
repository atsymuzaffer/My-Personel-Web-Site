@model PortfolioSite.Entities.Certificate
@{
    ViewData["Title"] = "Sertifika Ekle";
}
<div class="page-header"><h1 class="page-title">Sertifika Ekle</h1><a href="/Admin/Certificates" class="btn-admin btn-admin-secondary">← Geri</a></div>
<div class="admin-card"><div class="admin-card-body">
    <form asp-area="Admin" asp-controller="Certificates" asp-action="Create" method="post" enctype="multipart/form-data" class="admin-form">
        @Html.AntiForgeryToken()
        <div class="form-group"><label class="form-label">Sertifika Adı *</label><input asp-for="Name" class="form-control" required /></div>
        <div class="form-group"><label class="form-label">Sertifika Görseli</label><input type="file" name="image" class="form-control" accept="image/*" /></div>
        <div class="form-grid-2">
            <div class="form-group"><label class="form-label">Kurum</label><input asp-for="IssuingOrganization" class="form-control" /></div>
            <div class="form-group"><label class="form-label">Alınma Tarihi *</label><input asp-for="IssuedDate" class="form-control" type="date" required /></div>
        </div>
        <div class="form-group"><label class="form-label">Sona Erme Tarihi</label><input asp-for="ExpiryDate" class="form-control" type="date" /><small style="color:var(--admin-text-muted);">Süresiz ise boş bırakın.</small></div>
        <div class="form-grid-2">
            <div class="form-group"><label class="form-label">Credential ID</label><input asp-for="CredentialId" class="form-control" /></div>
            <div class="form-group"><label class="form-label">Doğrulama URL</label><input asp-for="VerificationUrl" class="form-control" /></div>
        </div>
        <div style="display:flex;gap:1rem;"><button type="submit" class="btn-admin btn-admin-primary">💾 Kaydet</button><a href="/Admin/Certificates" class="btn-admin btn-admin-secondary">İptal</a></div>
    </form>
</div></div>
