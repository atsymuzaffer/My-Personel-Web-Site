@model PortfolioSite.Entities.SiteProfile
@{
    ViewData["Title"] = "Profil";
}
<div class="page-header">
    <div><h1 class="page-title">Profil Yönetimi</h1><p class="page-subtitle">Kişisel bilgilerinizi ve CV'nizi yönetin</p></div>
</div>
<div class="admin-card">
    <div class="admin-card-header"><h2 class="admin-card-title">Profil Bilgileri</h2></div>
    <div class="admin-card-body">
        <form asp-area="Admin" asp-controller="Profile" asp-action="Index" method="post" enctype="multipart/form-data" class="admin-form">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">Ad Soyad</label><input asp-for="FullName" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Unvan</label><input asp-for="Title" class="form-control" /></div>
            </div>
            <div class="form-group"><label class="form-label">Kısa Biyografi (Hero alanı)</label><textarea asp-for="ShortBio" class="form-control" rows="2"></textarea></div>
            <div class="form-group"><label class="form-label">Hakkımda Metni (paragraflar arası boş satır bırakın)</label><textarea asp-for="AboutText" class="form-control" rows="5"></textarea></div>
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">E-posta</label><input asp-for="Email" class="form-control" type="email" /></div>
                <div class="form-group"><label class="form-label">Konum</label><input asp-for="Location" class="form-control" /></div>
            </div>
            <div class="form-group">
                <label class="form-label">Uzmanlık (Örn: SQL Server / C#)</label>
                <input asp-for="Specialization" class="form-control" placeholder="SQL Server / C#" />
            </div>
            <div class="form-group">
                <label class="form-label">Hero Üst Durum Etiketi (Örn: "Yeni fırsatlara açık" veya "Backend Dev @@ Şirket", boş bırakırsanız gizlenir)</label>
                <input asp-for="HeroBadgeText" class="form-control" placeholder="Yeni fırsatlara açık (boş bırakırsanız gizlenir)" />
            </div>
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">GitHub URL</label><input asp-for="GitHubUrl" class="form-control" /></div>
                <div class="form-group"><label class="form-label">LinkedIn URL</label><input asp-for="LinkedInUrl" class="form-control" /></div>
            </div>
            <div class="form-group"><label class="form-label">Meta Açıklaması (SEO)</label><input asp-for="MetaDescription" class="form-control" /></div>
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">Tamamlanan Proje Sayısı</label><input asp-for="CompletedProjects" class="form-control" type="number" /></div>
                <div class="form-group"><label class="form-label">Deneyim Yılı</label><input asp-for="YearsOfExperience" class="form-control" type="number" /></div>
            </div>
            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label">Profil Fotoğrafı</label>
                    @if (!string.IsNullOrEmpty(Model?.ProfileImagePath)) {
                        <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:var(--radius-sm);padding:0.75rem;margin-bottom:0.75rem;">
                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
                                <div>
                                    <span style="color:#34d399;font-weight:600;font-size:0.85rem;">✓ Yüklü Fotoğraf:</span>
                                    <span style="font-size:0.85rem;color:var(--admin-text-secondary);font-family:monospace;">@System.IO.Path.GetFileName(Model.ProfileImagePath)</span>
                                </div>
                                <button type="submit" form="deleteProfileImageForm" class="btn-admin btn-admin-danger btn-admin-sm" data-confirm-delete="Profil fotoğrafını silmek istediğinizden emin misiniz?">🗑 Fotoğrafı Sil</button>
                            </div>
                        </div>
                        <img src="@Model.ProfileImagePath" id="profilePreview" class="preview-img" style="margin-bottom:0.5rem;" />
                    } else {
                        <img id="profilePreview" class="preview-img" style="display:none;margin-bottom:0.5rem;" />
                    }
                    <div class="file-upload-area" style="margin-top:0.5rem;">
                        <input type="file" name="profileImage" accept=".jpg,.jpeg,.png,.webp" data-preview-target="profilePreview" onchange="if(this.files[0]) document.getElementById('profileImgFileName').innerText = 'Seçilen dosya: ' + this.files[0].name;" />
                        <div class="file-upload-icon">🖼</div>
                        <div class="file-upload-text">Fotoğraf seç veya sürükleyip bırak</div>
                        <div id="profileImgFileName" class="file-upload-hint" style="color:#60a5fa;font-weight:600;margin-top:0.25rem;">JPG, PNG, WebP • Maks 5MB</div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">CV Dosyası (PDF)</label>
                    @if (!string.IsNullOrEmpty(Model?.CvFilePath)) {
                        <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:var(--radius-sm);padding:0.75rem;margin-bottom:0.75rem;">
                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
                                <div>
                                    <span style="color:#34d399;font-weight:600;font-size:0.85rem;">✓ Yüklü CV:</span>
                                    <span style="font-size:0.85rem;color:var(--admin-text-secondary);font-family:monospace;">@System.IO.Path.GetFileName(Model.CvFilePath)</span>
                                    <span style="font-size:0.75rem;color:var(--admin-text-muted);margin-left:0.5rem;">(@(Model.CvDownloadCount) kez indirildi)</span>
                                </div>
                                <div style="display:flex;gap:0.5rem;">
                                    <a href="@Model.CvFilePath" target="_blank" class="btn-admin btn-admin-secondary btn-admin-sm">📄 Gör / İndir</a>
                                    <button type="submit" form="deleteCvForm" class="btn-admin btn-admin-danger btn-admin-sm" data-confirm-delete="Yüklü CV dosyasını silmek istediğinizden emin misiniz?">🗑 CV'yi Sil</button>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="file-upload-area">
                        <input type="file" name="cvFile" id="cvFileInput" accept=".pdf" onchange="if(this.files[0]) document.getElementById('cvFileName').innerText = 'Seçilen dosya: ' + this.files[0].name;" />
                        <div class="file-upload-icon">📄</div>
                        <div class="file-upload-text">PDF seç veya sürükleyip bırak</div>
                        <div id="cvFileName" class="file-upload-hint" style="color:#60a5fa;font-weight:600;margin-top:0.25rem;">Yalnızca PDF • Maks 10MB</div>
                    </div>
                </div>
            </div>
            <div style="display:flex;gap:1rem;margin-top:0.5rem;">
                <button type="submit" class="btn-admin btn-admin-primary">💾 Kaydet</button>
                <a href="/Admin/Dashboard" class="btn-admin btn-admin-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

<form id="deleteCvForm" asp-area="Admin" asp-controller="Profile" asp-action="DeleteCv" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<form id="deleteProfileImageForm" asp-area="Admin" asp-controller="Profile" asp-action="DeleteProfileImage" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>
