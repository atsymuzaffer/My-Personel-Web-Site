@model PortfolioSite.Entities.SiteProfile
@{
    ViewData["Title"] = "Profil";
}
<div class="page-header">
    <div><h1 class="page-title">Profil Yönetimi</h1><p class="page-subtitle">Kişisel bilgilerinizi ve CV'nizi yönetin</p></div>
</div>
<div class="admin-card">
    <div class="admin-card-header"><h2 class="admin-card-title">Profil Bilgileri</h2></div>
    <div class="admin-card-body">
        <form asp-area="Admin" asp-controller="Profile" asp-action="Index" method="post" enctype="multipart/form-data" class="admin-form">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">Ad Soyad</label><input asp-for="FullName" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Unvan</label><input asp-for="Title" class="form-control" /></div>
            </div>
            <div class="form-group"><label class="form-label">Kısa Biyografi (Hero alanı)</label><textarea asp-for="ShortBio" class="form-control" rows="2"></textarea></div>
            <div class="form-group"><label class="form-label">Hakkımda Metni (paragraflar arası boş satır bırakın)</label><textarea asp-for="AboutText" class="form-control" rows="5"></textarea></div>
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">E-posta</label><input asp-for="Email" class="form-control" type="email" /></div>
                <div class="form-group"><label class="form-label">Konum</label><input asp-for="Location" class="form-control" /></div>
            </div>
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">Hero Kart Etiket Başlığı</label><input asp-for="SpecializationLabel" class="form-control" placeholder="Uzmanlık" /></div>
                <div class="form-group"><label class="form-label">Hero Kart Etiket Değeri</label><input asp-for="Specialization" class="form-control" placeholder="SQL Server / C#" /></div>
            </div>

            <div style="border-top:1px solid var(--admin-border);padding-top:1rem;margin-top:0.5rem;margin-bottom:0.5rem;">
                <h3 style="font-size:0.95rem;color:var(--admin-accent);margin-bottom:0.75rem;">Hakkımda Sağ Kartı (Özelleştirilebilir Başlıklar & Değerler)</h3>
                <div class="form-grid-2">
                    <div class="form-group"><label class="form-label">1. Satır Başlığı</label><input asp-for="FocusAreaLabel" class="form-control" placeholder="Odak Alanı" /></div>
                    <div class="form-group"><label class="form-label">1. Satır Değeri</label><input asp-for="FocusArea" class="form-control" placeholder="Backend & Veritabanı Mimarisi" /></div>
                </div>
                <div class="form-grid-2">
                    <div class="form-group"><label class="form-label">2. Satır Başlığı</label><input asp-for="PrimaryTechsLabel" class="form-control" placeholder="Teknolojiler" /></div>
                    <div class="form-group"><label class="form-label">2. Satır Değeri</label><input asp-for="PrimaryTechs" class="form-control" placeholder="C#, ASP.NET Core, EF Core, SQL Server" /></div>
                </div>
                <div class="form-grid-2">
                    <div class="form-group"><label class="form-label">3. Satır Başlığı</label><input asp-for="DatabaseSkillsLabel" class="form-control" placeholder="Veritabanı Yetkinliği" /></div>
                    <div class="form-group"><label class="form-label">3. Satır Değeri</label><input asp-for="DatabaseSkills" class="form-control" placeholder="T-SQL, Stored Procedure, Trigger, CTE, JSON" /></div>
                </div>
                <div class="form-grid-2">
                    <div class="form-group"><label class="form-label">4. Satır Başlığı</label><input asp-for="BusinessProcessesLabel" class="form-control" placeholder="Süreçler" /></div>
                    <div class="form-group"><label class="form-label">4. Satır Değeri</label><input asp-for="BusinessProcesses" class="form-control" placeholder="ERP Entegrasyonu, İş Akışları, Muhasebe" /></div>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Hero Üst Durum Etiketi (Örn: "Yeni fırsatlara açık" veya "Backend Dev @@ Şirket", boş bırakırsanız gizlenir)</label>
                <input asp-for="HeroBadgeText" class="form-control" placeholder="Yeni fırsatlara açık (boş bırakırsanız gizlenir)" />
            </div>
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">GitHub URL</label><input asp-for="GitHubUrl" class="form-control" /></div>
                <div class="form-group"><label class="form-label">LinkedIn URL</label><input asp-for="LinkedInUrl" class="form-control" /></div>
            </div>
            <div class="form-group"><label class="form-label">Meta Açıklaması (SEO)</label><input asp-for="MetaDescription" class="form-control" /></div>
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">Tamamlanan Proje Sayısı</label><input asp-for="CompletedProjects" class="form-control" type="number" /></div>
                <div class="form-group"><label class="form-label">Deneyim Yılı</label><input asp-for="YearsOfExperience" class="form-control" type="number" /></div>
            </div>
            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label">Profil Fotoğrafı</label>
                    @if (!string.IsNullOrEmpty(Model?.ProfileImagePath)) {
                        <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:var(--radius-sm);padding:0.75rem;margin-bottom:0.75rem;">
                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
                                <div>
                                    <span style="color:#34d399;font-weight:600;font-size:0.85rem;">✓ Yüklü Fotoğraf:</span>
                                    <span style="font-size:0.85rem;color:var(--admin-text-secondary);font-family:monospace;">@System.IO.Path.GetFileName(Model.ProfileImagePath)</span>
                                </div>
                                <button type="submit" form="deleteProfileImageForm" class="btn-admin btn-admin-danger btn-admin-sm" data-confirm-delete="Profil fotoğrafını silmek istediğinizden emin misiniz?">🗑 Fotoğrafı Sil</button>
                            </div>
                        </div>
                        <img src="@Model.ProfileImagePath" id="profilePreview" class="preview-img" style="margin-bottom:0.5rem;" />
                    } else {
                        <img id="profilePreview" class="preview-img" style="display:none;margin-bottom:0.5rem;" />
                    }
                    <div class="file-upload-area" style="margin-top:0.5rem;">
                        <input type="file" name="profileImage" accept=".jpg,.jpeg,.png,.webp" data-preview-target="profilePreview" onchange="if(this.files[0]) document.getElementById('profileImgFileName').innerText = 'Seçilen dosya: ' + this.files[0].name;" />
                        <div class="file-upload-icon">🖼</div>
                        <div class="file-upload-text">Fotoğraf seç veya sürükleyip bırak</div>
                        <div id="profileImgFileName" class="file-upload-hint" style="color:var(--admin-accent);font-weight:600;margin-top:0.25rem;">JPG, PNG, WebP • Maks 5MB</div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">CV Dosyası (PDF)</label>
                    @if (!string.IsNullOrEmpty(Model?.CvFilePath)) {
                        <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:var(--radius-sm);padding:0.75rem;margin-bottom:0.75rem;">
                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
                                <div>
                                    <span style="color:#34d399;font-weight:600;font-size:0.85rem;">✓ Yüklü CV:</span>
                                    <span style="font-size:0.85rem;color:var(--admin-text-secondary);font-family:monospace;">@System.IO.Path.GetFileName(Model.CvFilePath)</span>
                                    <span style="font-size:0.75rem;color:var(--admin-text-muted);margin-left:0.5rem;">(@(Model.CvDownloadCount) kez indirildi)</span>
                                </div>
                                <div style="display:flex;gap:0.5rem;">
                                    <a href="@Model.CvFilePath" target="_blank" class="btn-admin btn-admin-secondary btn-admin-sm">📄 Gör / İndir</a>
                                    <button type="submit" form="deleteCvForm" class="btn-admin btn-admin-danger btn-admin-sm" data-confirm-delete="Yüklü CV dosyasını silmek istediğinizden emin misiniz?">🗑 CV'yi Sil</button>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="file-upload-area">
                        <input type="file" name="cvFile" id="cvFileInput" accept=".pdf" onchange="if(this.files[0]) document.getElementById('cvFileName').innerText = 'Seçilen dosya: ' + this.files[0].name;" />
                        <div class="file-upload-icon">📄</div>
                        <div class="file-upload-text">PDF seç veya sürükleyip bırak</div>
                        <div id="cvFileName" class="file-upload-hint" style="color:var(--admin-accent);font-weight:600;margin-top:0.25rem;">Yalnızca PDF • Maks 10MB</div>
                    </div>
                </div>
            </div>

            <div class="form-grid-2" style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--admin-border);">
                <div class="form-group">
                    <label class="form-label">Favicon (Sekme İkonu)</label>
                    @if (!string.IsNullOrEmpty(Model?.FaviconPath)) {
                        <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:var(--radius-sm);padding:0.75rem;margin-bottom:0.75rem;">
                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
                                <div style="display:flex;align-items:center;gap:0.5rem;">
                                    <img src="@Model.FaviconPath" style="width:24px;height:24px;object-fit:contain;background:#0F1115;padding:2px;border-radius:3px;" />
                                    <span style="color:#34d399;font-weight:600;font-size:0.85rem;">✓ Yüklü Favicon:</span>
                                    <span style="font-size:0.85rem;color:var(--admin-text-secondary);font-family:monospace;">@System.IO.Path.GetFileName(Model.FaviconPath)</span>
                                </div>
                                <button type="submit" form="deleteFaviconForm" class="btn-admin btn-admin-danger btn-admin-sm" data-confirm-delete="Favicon'u silmek ve otomatik oluşturulan ikona dönmek istediğinizden emin misiniz?">🗑 Favicon'u Sil</button>
                            </div>
                        </div>
                    } else {
                        <div style="background:rgba(255,255,255,0.03);border:1px solid var(--admin-border);border-radius:var(--radius-sm);padding:0.6rem 0.75rem;margin-bottom:0.75rem;font-size:0.825rem;color:var(--admin-text-muted);">
                            ℹ️ Özel favicon yüklü değil. İsminizin baş harflerinden otomatik SVG ikon üretilmektedir.
                        </div>
                    }
                    <div class="file-upload-area">
                        <input type="file" name="faviconFile" id="faviconFileInput" accept=".ico,.png,.svg,.webp" onchange="if(this.files[0]) document.getElementById('faviconFileName').innerText = 'Seçilen dosya: ' + this.files[0].name;" />
                        <div class="file-upload-icon">🌐</div>
                        <div class="file-upload-text">Özel Favicon seç veya sürükleyip bırak</div>
                        <div id="faviconFileName" class="file-upload-hint" style="color:var(--admin-accent);font-weight:600;margin-top:0.25rem;">ICO, PNG, SVG veya WebP • Maks 2MB</div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Site Logosu (Navbar İsim Yerine)</label>
                    @if (!string.IsNullOrEmpty(Model?.LogoPath)) {
                        <div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:var(--radius-sm);padding:0.75rem;margin-bottom:0.75rem;">
                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
                                <div style="display:flex;align-items:center;gap:0.5rem;">
                                    <img src="@Model.LogoPath" style="max-height:28px;max-width:80px;object-fit:contain;background:#0F1115;padding:2px 4px;border-radius:3px;" />
                                    <span style="color:#34d399;font-weight:600;font-size:0.85rem;">✓ Yüklü Logo:</span>
                                    <span style="font-size:0.85rem;color:var(--admin-text-secondary);font-family:monospace;">@System.IO.Path.GetFileName(Model.LogoPath)</span>
                                </div>
                                <button type="submit" form="deleteLogoForm" class="btn-admin btn-admin-danger btn-admin-sm" data-confirm-delete="Site logosunu silmek ve ad-soyad metnine dönmek istediğinizden emin misiniz?">🗑 Logoyu Sil</button>
                            </div>
                        </div>
                    } else {
                        <div style="background:rgba(255,255,255,0.03);border:1px solid var(--admin-border);border-radius:var(--radius-sm);padding:0.6rem 0.75rem;margin-bottom:0.75rem;font-size:0.825rem;color:var(--admin-text-muted);">
                            ℹ️ Özel logo yüklü değil. Üst menüde adınız ve soyadınız ("@(Model?.FullName ?? "İsim Soyisim")") gösterilmektedir.
                        </div>
                    }
                    <div class="file-upload-area">
                        <input type="file" name="logoFile" id="logoFileInput" accept=".png,.svg,.jpg,.jpeg,.webp" onchange="if(this.files[0]) document.getElementById('logoFileName').innerText = 'Seçilen dosya: ' + this.files[0].name;" />
                        <div class="file-upload-icon">🎨</div>
                        <div class="file-upload-text">Logo seç veya sürükleyip bırak</div>
                        <div id="logoFileName" class="file-upload-hint" style="color:var(--admin-accent);font-weight:600;margin-top:0.25rem;">PNG, SVG, JPG veya WebP • Maks 5MB</div>
                    </div>
                </div>
            </div>

            <div style="display:flex;gap:1rem;margin-top:1rem;">
                <button type="submit" class="btn-admin btn-admin-primary">💾 Kaydet</button>
                <a href="/Admin/Dashboard" class="btn-admin btn-admin-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

<form id="deleteCvForm" asp-area="Admin" asp-controller="Profile" asp-action="DeleteCv" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<form id="deleteProfileImageForm" asp-area="Admin" asp-controller="Profile" asp-action="DeleteProfileImage" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<form id="deleteFaviconForm" asp-area="Admin" asp-controller="Profile" asp-action="DeleteFavicon" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<form id="deleteLogoForm" asp-area="Admin" asp-controller="Profile" asp-action="DeleteLogo" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>
