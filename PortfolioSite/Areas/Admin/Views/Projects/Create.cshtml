@model PortfolioSite.Entities.Project
@{
    ViewData["Title"] = "Yeni Proje";
}
<div class="page-header">
    <div><h1 class="page-title">Yeni Proje Ekle</h1></div>
    <a href="/Admin/Projects" class="btn-admin btn-admin-secondary">← Geri</a>
</div>
<div class="admin-card">
    <div class="admin-card-body">
        <form asp-area="Admin" asp-controller="Projects" asp-action="Create" method="post" enctype="multipart/form-data" class="admin-form">
            @Html.AntiForgeryToken()
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">Proje Adı *</label><input asp-for="Name" class="form-control" required /><span asp-validation-for="Name" class="text-danger"></span></div>
                <div class="form-group"><label class="form-label">Durum</label><select asp-for="Status" class="form-control"><option value="0">Geliştiriliyor</option><option value="1" selected>Tamamlandı</option><option value="2">Arşivlendi</option></select></div>
            </div>
            <div class="form-group"><label class="form-label">Kısa Özet</label><input asp-for="Summary" class="form-control" /></div>
            <div class="form-group"><label class="form-label">Açıklama</label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
            <div class="form-group"><label class="form-label">Kullanılan Teknolojiler (virgülle ayırın)</label><input asp-for="Technologies" class="form-control" placeholder="C#, ASP.NET Core, SQL Server" /></div>
            <div class="form-grid-2">
                <div class="form-group"><label class="form-label">GitHub URL</label><input asp-for="GitHubUrl" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Canlı Demo URL</label><input asp-for="LiveUrl" class="form-control" /></div>
            </div>
            <div class="form-group">
                <label class="form-label">Kapak Görseli</label>
                <img id="coverPreview" class="preview-img" style="display:none;" />
                <div class="file-upload-area" style="margin-top:0.5rem;">
                    <input type="file" name="coverImage" accept=".jpg,.jpeg,.png,.webp" data-preview-target="coverPreview" />
                    <div class="file-upload-icon">🖼</div>
                    <div class="file-upload-text">Görsel seç veya sürüklep bırak</div>
                    <div class="file-upload-hint">JPG, PNG, WebP • Maks 5MB</div>
                </div>
            </div>
            <div style="display:flex;gap:0.75rem;align-items:center;">
                <div class="form-check" style="margin:0;">
                    <input asp-for="IsFeatured" class="form-check-input" id="featured" />
                    <label for="featured" class="form-check-label" style="font-size:0.875rem;color:var(--admin-text-secondary);">Ana sayfada öne çıkar</label>
                </div>
                <div class="form-check" style="margin:0;">
                    <input asp-for="IsActive" class="form-check-input" id="active" checked />
                    <label for="active" class="form-check-label" style="font-size:0.875rem;color:var(--admin-text-secondary);">Aktif (yayında)</label>
                </div>
            </div>
            <div style="margin-top:1.5rem;display:flex;gap:1rem;">
                <button type="submit" class="btn-admin btn-admin-primary">💾 Kaydet</button>
                <a href="/Admin/Projects" class="btn-admin btn-admin-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
