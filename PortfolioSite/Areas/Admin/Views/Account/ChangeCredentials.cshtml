@model PortfolioSite.ViewModels.ChangeCredentialsViewModel
@{
    ViewData["Title"] = "Hesap & Şifre Ayarları";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Hesap & Şifre Ayarları</h1>
        <p style="color: var(--admin-text-muted); font-size: 0.875rem; margin-top: 0.25rem;">
            Admin paneli giriş e-posta adresinizi ve şifrenizi buradan güncelleyebilirsiniz.
        </p>
    </div>
</div>

<div class="admin-card" style="max-width: 650px;">
    <div class="admin-card-body">
        <form asp-area="Admin" asp-controller="Account" asp-action="ChangeCredentials" method="post" class="admin-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-error" style="margin-bottom: 1.5rem;"></div>

            <div class="form-group">
                <label class="form-label" asp-for="CurrentEmail">Aktif E-Posta Adresi</label>
                <input asp-for="CurrentEmail" class="form-control" readonly style="opacity: 0.7; background-color: var(--admin-bg-hover);" />
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="NewEmail">Yeni E-Posta Adresi *</label>
                <input asp-for="NewEmail" class="form-control" required type="email" placeholder="yeniemail@domain.com" />
                <span asp-validation-for="NewEmail" style="color: var(--admin-danger); font-size: 0.8rem; margin-top: 0.25rem; display: block;"></span>
            </div>

            <hr style="border: none; border-top: 1px solid var(--admin-border); margin: 1.5rem 0;" />

            <div class="form-group">
                <label class="form-label" asp-for="CurrentPassword">Mevcut Şifreniz *</label>
                <input asp-for="CurrentPassword" class="form-control" required type="password" placeholder="••••••••" />
                <small style="color: var(--admin-text-muted); display: block; margin-top: 0.25rem;">
                    Güvenlik doğrulaması için mevcut şifrenizi girmeniz zorunludur.
                </small>
                <span asp-validation-for="CurrentPassword" style="color: var(--admin-danger); font-size: 0.8rem; margin-top: 0.25rem; display: block;"></span>
            </div>

            <hr style="border: none; border-top: 1px solid var(--admin-border); margin: 1.5rem 0;" />

            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label" asp-for="NewPassword">Yeni Şifre</label>
                    <input asp-for="NewPassword" class="form-control" type="password" placeholder="En az 8 karakter" />
                    <span asp-validation-for="NewPassword" style="color: var(--admin-danger); font-size: 0.8rem; margin-top: 0.25rem; display: block;"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="ConfirmNewPassword">Yeni Şifre Tekrar</label>
                    <input asp-for="ConfirmNewPassword" class="form-control" type="password" placeholder="Yeni şifreyi doğrulayın" />
                    <span asp-validation-for="ConfirmNewPassword" style="color: var(--admin-danger); font-size: 0.8rem; margin-top: 0.25rem; display: block;"></span>
                </div>
            </div>
            <small style="color: var(--admin-text-muted); display: block; margin-top: -0.5rem; margin-bottom: 1.5rem;">
                Şifrenizi değiştirmek istemiyorsanız bu alanları boş bırakabilirsiniz.
            </small>

            <div style="display: flex; gap: 1rem; align-items: center; margin-top: 2rem;">
                <button type="submit" class="btn-admin btn-admin-primary">
                    💾 Değişiklikleri Kaydet
                </button>
                <a href="/Admin/Dashboard" class="btn-admin btn-admin-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
