@inject PortfolioSite.Interfaces.IPortfolioService PortfolioService
@{
    Layout = null;
    ViewData["Title"] = "Admin Girişi";
    var profile = await PortfolioService.GetProfileAsync();
    var fullName = profile?.FullName ?? "Muzaffer Atasoy";
    var initials = "MA";
    if (!string.IsNullOrWhiteSpace(fullName)) {
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = parts.Length > 1 ? $"{parts[0][0]}{parts[^1][0]}".ToUpper() : parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
    }
    var defaultSvgIcon = $"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%230F1115'/%3E%3Crect width='94' height='94' x='3' y='3' rx='22' fill='none' stroke='%23178A90' stroke-width='4' opacity='0.4'/%3E%3Ctext x='50' y='55' font-family='-apple-system,system-ui,sans-serif' font-size='44' font-weight='800' fill='%23178A90' text-anchor='middle' dominant-baseline='central'%3E{initials}%3C/text%3E%3C/svg%3E";
    var faviconUrl = !string.IsNullOrEmpty(profile?.FaviconPath) ? profile.FaviconPath : defaultSvgIcon;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Admin Girişi | @fullName</title>
    <link rel="icon" type="image/x-icon" href="@faviconUrl" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="@faviconUrl" asp-append-version="true" />
    <link rel="shortcut icon" href="@faviconUrl" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
<main class="login-page">
    <div class="login-card">
        <div class="login-header">
            <div class="login-logo">ADMIN</div>
            <h1 class="login-title">Admin Paneli</h1>
            <p class="login-subtitle">Devam etmek için giriş yapın</p>
        </div>

        @if (!ViewData.ModelState.IsValid) {
            <div class="alert alert-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors)) {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post" class="admin-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            
            <div class="form-group">
                <label class="form-label" for="email">E-posta</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="admin@example.com" required autofocus />
            </div>
            
            <div class="form-group">
                <label class="form-label" for="password">Şifre</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="Şifreniz" required />
            </div>
            
            <button type="submit" class="btn-admin btn-admin-primary" style="width:100%;justify-content:center;padding:0.75rem;margin-top:0.5rem;">
                Giriş Yap
            </button>
        </form>
    </div>
</main>
</body>
</html>
